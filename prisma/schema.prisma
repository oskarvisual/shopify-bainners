// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Shopify session management
model Session {
  id                  String    @id @db.VarChar(255)
  shop                String    @db.VarChar(255)
  state               String    @db.VarChar(255)
  isOnline            Boolean   @default(false)
  scope               String?   @db.Text
  expires             DateTime?
  accessToken         String    @db.Text
  userId              BigInt?
  firstName           String?   @db.VarChar(255)
  lastName            String?   @db.VarChar(255)
  email               String?   @db.VarChar(255)
  accountOwner        Boolean   @default(false)
  locale              String?   @db.VarChar(50)
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?   @db.Text
  refreshTokenExpires DateTime?

  @@index([shop])
}

// Shop/Store information
model Shop {
  id              String   @id @default(uuid())
  shopDomain      String   @unique @db.VarChar(255)
  name            String?  @db.VarChar(255)
  email           String?  @db.VarChar(255)
  plan            String   @default("free") @db.VarChar(50) // free, pro, ultra
  storageUsedGB   Float    @default(0)
  storageLimitGB  Float    @default(1) // 1GB for free
  isActive        Boolean  @default(true)
  installedAt     DateTime @default(now())
  uninstalledAt   DateTime?
  setupGuideDismissedAt DateTime?
  defaultBannerBackgroundColor String? @db.VarChar(20)
  defaultTitleFontSize String? @db.VarChar(20)
  defaultDescriptionFontSize String? @db.VarChar(20)
  defaultTitleColor String? @db.VarChar(20)
  defaultDescriptionColor String? @db.VarChar(20)
  defaultCtaTextColor String? @db.VarChar(20)
  defaultCtaBackgroundColor String? @db.VarChar(20)
  defaultCtaBorderColor String? @db.VarChar(20)
  defaultCtaBordered Boolean @default(false)
  defaultCtaRounded Boolean @default(true)
  defaultCtaShadow Boolean @default(false)
  defaultCountdownTextColor String? @db.VarChar(20)
  defaultCountdownBackgroundColor String? @db.VarChar(20)
  defaultCountdownStyle String? @db.VarChar(20)
  defaultSliderArrowStyle String? @db.VarChar(20)
  defaultSliderArrowColor String? @db.VarChar(20)
  defaultSliderBulletColor String? @db.VarChar(20)
  defaultAnnouncementMarquee Boolean @default(false)
  defaultAnnouncementAnimation String? @db.VarChar(20)
  defaultAnnouncementCloseColor String? @db.VarChar(20)
  defaultAnnouncementClosable Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  banners         Banner[]
  bannerItems     BannerItem[]
  images          Image[]
  styles          Style[]
  analytics       BannerAnalytic[]
  itemAnalytics   BannerItemAnalytic[]
  bannerEvents    BannerEvent[]

  @@index([shopDomain])
  @@index([plan])
}

// Banners
model Banner {
  id                  String    @id @default(uuid())
  shopId              String
  shop                Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // Basic info
  title               String    @db.VarChar(255)
  descriptionInternal String?   @db.Text
  status              String    @default("draft") @db.VarChar(50) // draft, active, archived

  // Layout & scheduling
  layout              String    @db.VarChar(50) // announcement, hero, slider
  sliderType          String?   @db.VarChar(50)
  sliderShowArrows    Boolean   @default(true)
  sliderShowBullets   Boolean   @default(true)
  sliderAutoplay      Boolean   @default(false)
  sliderLoop          Boolean   @default(true)
  sliderPerView       Float     @default(1)
  sliderSpeed         String?   @db.VarChar(20)
  sliderAutoplayDelay Int?
  sliderCentered      Boolean   @default(false)
  sliderSpaceBetween  Int?
  sliderPauseOnHover  Boolean   @default(true)
  sliderArrowStyle    String?   @db.VarChar(20)
  sliderArrowColor    String?   @db.VarChar(20)
  sliderBulletColor   String?   @db.VarChar(20)
  scheduledStartAt    DateTime?
  scheduledEndAt      DateTime?
  announcementText    String?   @db.Text
  announcementCtaText String?   @db.VarChar(100)
  announcementCtaUrl  String?   @db.Text
  announcementCtaTarget String? @db.VarChar(20)
  announcementClosable Boolean  @default(false)
  announcementCloseColor String? @db.VarChar(20)
  announcementMarquee Boolean   @default(false)
  announcementAnimation String? @db.VarChar(20)
  announcementShowCountdown Boolean @default(false)
  announcementCountdownMode String? @db.VarChar(50)
  announcementCountdownEndAt DateTime?
  announcementCountdownTimezone String? @db.VarChar(64)
  announcementCountdownDurationHours String? @db.VarChar(20)
  bannerBackgroundColor String? @db.VarChar(20)
  titleFontSize       String?   @db.VarChar(20)
  descriptionFontSize String?   @db.VarChar(20)
  titleColor          String?   @db.VarChar(20)
  descriptionColor    String?   @db.VarChar(20)
  ctaTextColor        String?   @db.VarChar(20)
  ctaBackgroundColor  String?   @db.VarChar(20)
  ctaBorderColor      String?   @db.VarChar(20)
  ctaBordered         Boolean   @default(false)
  ctaRounded          Boolean   @default(true)
  ctaShadow           Boolean   @default(false)
  countdownTextColor  String?   @db.VarChar(20)
  countdownBackgroundColor String? @db.VarChar(20)
  countdownStyle      String?   @db.VarChar(20)
  customCss           String?   @db.Text

  // CTA configuration
  ctaText             String?   @db.VarChar(100)
  ctaUrl              String?   @db.Text
  ctaTarget           String?   @db.VarChar(20) // _self, _blank
  ctaStyle            String?   @db.VarChar(50) // button, link, badge
  showCta             Boolean   @default(true)

  // Text configuration
  textMode            String    @default("overlay") @db.VarChar(50) // overlay, embedded
  textTitle           String?   @db.VarChar(255)
  textSubtitle        String?   @db.VarChar(255)
  textPosition        String?   @db.VarChar(50) // left, right, center, top, bottom
  textColors          Json?     // { title: "#fff", subtitle: "#eee", button: "#000" }

  // Product context (if associated with a product)
  productId           String?   @db.VarChar(255)
  productTitle        String?   @db.VarChar(255)
  productDescription  String?   @db.Text
  collectionName      String?   @db.VarChar(255)

  // Display order (for drag & drop)
  displayOrder        Int       @default(0)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  bannerItems         BannerItem[]
  analytics           BannerAnalytic[]
  events              BannerEvent[]

  @@index([shopId])
  @@index([status])
  @@index([layout])
  @@index([createdAt])
}

// Banner Items (what's displayed in each banner - references Image or external URL)
model BannerItem {
  id                String   @id @default(uuid())
  shopId            String
  shop              Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bannerId          String
  banner            Banner   @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  // Image reference - either our hosted image OR external Shopify URL
  imageId           String?  // Reference to Image table (for ai_generated, uploaded)
  image             Image?   @relation(fields: [imageId], references: [id], onDelete: SetNull)
  externalImageUrl  String?  @db.Text // For Shopify product images (doesn't count toward storage)

  // Banner item specific data (for sliders, text overlays, etc.)
  title             String?  @db.VarChar(255)
  description       String?  @db.Text
  displayOrder      Int      @default(0)

  // Selection/variant info
  isSelected        Boolean  @default(false)
  variantIndex      Int?

  // Metadata
  alt               String?  @db.VarChar(255)
  tags              Json?    // Array of tags
  analytics         BannerAnalytic[]
  itemAnalytics     BannerItemAnalytic[]
  events            BannerEvent[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([shopId])
  @@index([bannerId])
  @@index([imageId])
  @@index([displayOrder])
}

// Image Storage (ALL images we host - for GB usage calculation and gallery)
model Image {
  id                  String   @id @default(uuid())
  shopId              String
  shop                Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // File info
  filename            String   @db.VarChar(255)
  storageUrl          String   @db.Text // S3/CDN URL
  sizeInMB            Float    // Parsed from "1.65 MB" format

  // Image properties
  width               Int
  height              Int
  aspectRatio         String   @db.VarChar(20) // "16:9", "4:5", etc.
  format              String   @db.VarChar(10) // webp, png, jpg

  // Source tracking
  sourceType          String   @db.VarChar(50) // ai_generated, uploaded

  // Usage tracking - which banners use this image
  bannerItems         BannerItem[]

  createdAt           DateTime @default(now())

  @@index([shopId])
  @@index([sourceType])
  @@index([createdAt])
}

// Custom Style Presets (Ultra feature)
model Style {
  id                          String   @id @default(uuid())
  shopId                      String
  shop                        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // Identity
  name                        String   @db.VarChar(255)
  category                    String?  @db.VarChar(100) // Luxury, Sport, Fashion, Tech, Outdoors, Seasonal
  status                      String   @default("draft") @db.VarChar(50) // active, draft
  description                 String?  @db.Text

  // Creative direction
  stylePrompt                 String   @db.Text
  negativePrompt              String?  @db.Text
  toneKeywords                Json?    // Array of keywords
  avoidTextInImage            Boolean  @default(true)
  strictProductPreservation   Boolean  @default(true)

  // Composition defaults
  defaultComposition          String?  @db.VarChar(50) // product_left, product_right, centered, rule_of_thirds
  backgroundStyle             String?  @db.VarChar(50) // clean, gradient, studio, lifestyle, pattern
  cameraFeel                  String?  @db.VarChar(50) // wide, medium, close_up
  depthOfField                String?  @db.VarChar(50) // none, subtle, strong
  safeAreaProfile             String?  @db.VarChar(50) // left_text, right_text, top_strip, bottom_cta

  // Branding & colors
  primaryColor                String?  @db.VarChar(7) // #RRGGBB
  accentColor                 String?  @db.VarChar(7)
  backgroundColorHint         String?  @db.VarChar(7)
  allowGradients              Boolean  @default(true)
  logoUsage                   String?  @db.VarChar(50) // none, corner, watermark, overlay

  // Output defaults
  defaultAspectRatios         Json?    // Array of aspect ratios
  defaultResolution           String?  @db.VarChar(50)
  outputFormat                String   @default("webp") @db.VarChar(10)
  compressionTarget           String?  @db.VarChar(50) // 150KB, 300KB, 500KB

  // Compliance rules
  complianceRules             Json?    // { noExtraProducts, noCompetingBrands, noTextArtifacts, etc. }

  // Usage tracking
  usageCount                  Int      @default(0)
  isDefault                   Boolean  @default(false)

  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@index([shopId])
  @@index([status])
  @@index([category])
  @@index([isDefault])
}

// Analytics (Pro+ feature)
model BannerAnalytic {
  id        String   @id @default(uuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bannerId  String
  banner    Banner   @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  bannerItemId String?
  bannerItem   BannerItem? @relation(fields: [bannerItemId], references: [id], onDelete: SetNull)

  date      DateTime @db.Date
  views     Int      @default(0)
  clicks    Int      @default(0)
  ctr       Float    @default(0) // Click-through rate (calculated)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bannerId, date])
  @@index([shopId])
  @@index([bannerId])
  @@index([bannerItemId])
  @@index([date])
}

model BannerItemAnalytic {
  id           String   @id @default(uuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bannerItemId String
  bannerItem   BannerItem @relation(fields: [bannerItemId], references: [id], onDelete: Cascade)

  date   DateTime @db.Date
  views  Int      @default(0)
  clicks Int      @default(0)
  ctr    Float    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bannerItemId, date])
  @@index([shopId])
  @@index([bannerItemId])
  @@index([date])
}

model BannerEvent {
  id           String   @id @default(uuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bannerId     String
  banner       Banner   @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  bannerItemId String?
  bannerItem   BannerItem? @relation(fields: [bannerItemId], references: [id], onDelete: SetNull)

  eventType String   @db.VarChar(20) // view, click
  pageUrl   String?  @db.Text
  pagePath  String?  @db.Text
  referrer  String?  @db.Text
  userAgent String?  @db.Text
  device    String?  @db.VarChar(20)

  createdAt DateTime @default(now())

  @@index([shopId])
  @@index([bannerId])
  @@index([bannerItemId])
  @@index([eventType])
  @@index([createdAt])
}
